{
  "name": "cowsay",
  "version": "1.0.0",
  "description": "A simple cowsay application",
  "repository": {
    "type": "git",
    "url": "https://github.com/meowso/cowsay"
  },
  "scripts": {
    "clean": "rm -rf dist/**.*",
    "compile": "tsc",
    "start": "bun run clean && bun run compile && bun run say && bun run lolcat && bun run convert && bun run tweet ",
    "convert": "bun dist/convert.js",
    "say": "bun dist/say.js",
    "lolcat": "bun dist/lolcat.js > ./dist/lolcat.ansi",
    "tweet": "bun dist/tweet.js",
    "local": "bash tweet_local.sh",
    "generate-tiers": "bun src/generate-tiers.ts",
    "generate-shop": "bun src/generate-shop.ts",
    "generate-artwork": "bun src/generate-artwork.ts"
  },
  "keywords": [
    "cowsay",
    "lolcatjs",
    "twitter-api-v2",
    "tweet",
    "nodejs",
    "typescript"
  ],
  "author": {
    "name": "Bruno Palma",
    "email": "cat@cowsay.co",
    "url": "http://about.me/bruno_vop"
  },
  "license": "MIT",
  "dependencies": {
    "ansi-to-html": "^0.7.2",
    "cowsay": "^1.6.0",
    "dotenv": "^16.4.5",
    "lolcatjs": "^2.4.3",
    "node-html-to-image": "^5.0.0",
    "node-pty": "^1.0.0",
    "twitter-api-v2": "^1.17.2",
    "typescript": "^5.6.2",
    "word-wrap": "^1.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/lolcatjs": "^2.4.1"
  }
}
